/* config.hpp - 由 CMake configure_file 生成，勿手动修改 */
/* 仅保留被源码引用的特性宏；基础 libc 头文件在 ztnvr.hpp 中无条件包含 */

/* NLS（预留钩子：CMake 未设置变量时保持未定义） */
#cmakedefine ENABLE_NLS
#cmakedefine HAVE_GETTEXT

/* 数据库后端（dbse） */
#cmakedefine HAVE_MARIADB
#cmakedefine HAVE_MYSQL
#cmakedefine HAVE_PGSQLDB
#cmakedefine HAVE_PGSQL
#cmakedefine HAVE_SQLITE3DB

/* 可选库 */
#cmakedefine HAVE_ALSA
#cmakedefine HAVE_FFTW3
#cmakedefine HAVE_LIBCAM
#cmakedefine HAVE_OPENCV
#cmakedefine HAVE_PULSE
#cmakedefine HAVE_WEBP
#cmakedefine HAVE_V4L2

/* 平台特性（非致命探测，缺失时源码走降级路径） */
#cmakedefine HAVE_LINUX_VIDEODEV2_H
#cmakedefine HAVE_PTHREAD_NP_H
#cmakedefine HAVE_REGEX_H
#cmakedefine HAVE_PTHREAD_SETNAME_NP
#cmakedefine HAVE_PTHREAD_GETNAME_NP
#cmakedefine XSI_STRERROR_R

/* 包信息（VERSION 被版本字符串/API 响应引用） */
#define PACKAGE_VERSION "@PROJECT_VERSION@"
#define VERSION "@PROJECT_VERSION@"
